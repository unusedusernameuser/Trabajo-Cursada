package views

// UserForm renderiza el formulario para crear un usuario.
// HTMX envía POST /users y coloca la respuesta (la lista actualizada) en #user-list.
// Si el servidor rechaza el envío, responde con este mismo componente (con el error)
// y redirige el reemplazo a #user-form con los headers HX-Retarget / HX-Reswap.
// En un alta exitosa la respuesta incluye además un formulario vacío con OOB=true,
// que HTMX intercambia fuera de banda para limpiar los campos.
// El atributo method/action se mantiene como respaldo si HTMX no está disponible.
templ UserForm(f UserFormValues) {
	<article id="user-form" { oobAttrs(f.OOB)... }>
		<header>
			<h2>Nuevo usuario</h2>
		</header>
		<form method="post" action="/users" hx-post="/users" hx-target="#user-list" hx-swap="outerHTML">
			if f.Error != "" {
				<p role="alert"><mark>{ f.Error }</mark></p>
			}
			<label>
				Nombre de usuario
				<input name="handle" type="text" maxlength="31" autocomplete="off" value={ f.Handle } required/>
			</label>
			<label>
				Nombre para mostrar
				<input name="display_name" type="text" maxlength="63" autocomplete="off" value={ f.DisplayName } required/>
			</label>
			<label>
				Email
				<input name="email" type="email" maxlength="255" autocomplete="off" value={ f.Email } required/>
			</label>
			<label>
				Contraseña
				<input name="password" type="password" maxlength="255" autocomplete="new-password" required/>
			</label>
			<button type="submit">Crear usuario</button>
		</form>
	</article>
}
