package views

import (
	"strconv"

	db "my_sqlc_project/db/sqlc"
)

// UserList recibe el slice que devuelve ListUsers de sqlc y renderiza la tabla.
templ UserList(users []db.ListUsersRow) {
	<article id="user-list">
		<header>
			<h2>Usuarios</h2>
		</header>
		if len(users) == 0 {
			<p>Todavía no hay usuarios. Creá el primero con el formulario.</p>
		} else {
			<div class="overflow-auto">
				<table class="striped">
					<thead>
						<tr>
							<th scope="col">Usuario</th>
							<th scope="col">Nombre</th>
							<th scope="col">Email</th>
							<th scope="col">Alta</th>
							<th scope="col"><span class="visually-hidden">Acciones</span></th>
						</tr>
					</thead>
					<tbody>
						for _, u := range users {
							<tr id={ "user-" + strconv.Itoa(int(u.ID)) }>
								<td><a href={ templ.SafeURL(userTasksURL(u.ID)) }>{ "@" + u.Handle }</a></td>
								<td>{ u.DisplayName }</td>
								<td>{ u.Email }</td>
								<td>{ formatDate(u.CreatedAt) }</td>
								<td>
									<a href={ templ.SafeURL(userTasksURL(u.ID)) } role="button" class="outline">Tareas</a>
									<button
										class="secondary outline"
										hx-delete={ userDeleteURL(u.ID) }
										hx-target="closest tr"
										hx-swap="outerHTML"
										hx-confirm="¿Eliminar este usuario?"
									>Eliminar</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</article>
}
